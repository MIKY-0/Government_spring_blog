{{> layout/header}}

<div class="container p-5">
{{!boardPage - PageDto}}
    {{#boardPage.content}}
        <div class="card mb-3">
            <div class="card-body">
                <h4 class="card-title">{{title}}</h4>
                <!-- board의 getTime()메서드 만들어놓음. get은 제외하고 time만 작성. -->
                <p>작성자 : {{user.username}} | 작성일 : {{time}}</p>
                <p>작성자 : {{username}} | 작성일 : {{createdAt}}</p>
                <a href="/board/{{id}}" class="btn btn-primary">상세보기</a>
            </div>
        </div>
    {{/boardPage.content}}

    {{^boardPage.content}}
        <div class="text-center mt-5">
            <h5>게시글이 없습니다.</h5>
        </div>
    {{/boardPage.content}}

    {{#boardPage.pageLinks}}
        <li class="page-item" {{#active}}active{{/active}}>
            <a class="page-link" href="/?page={{num}}&size={{boardPage.size}}">{{num}}</a>
        </li>
    {{/boardPage.pageLinks}}

    <ul class="pagination  d-flex justify-content-center">
        {{#boardPage.hasPrevious}}
            <li class="page-item">
                <a class="page-link" href="/?page={{boardPage.PreviousPage}}&size={{boardPage.size}}">이전페이지</a>
            </li>
        {{/boardPage.hasPrevious}}


    </ul>

    <!--  페이지네이션(추후 구현 예정)  -->
    <ul class="pagination d-flex justify-content-center">
        <li class="page-item disabled"><a class="page-link" href="#">Previous</a></li>
        <li class="page-item "><a class="page-link" href="#">1</a></li>
        <li class="page-item "><a class="page-link" href="#">2</a></li>
        <li class="page-item"><a class="page-link" href="#">Next</a></li>
    </ul>
</div>
