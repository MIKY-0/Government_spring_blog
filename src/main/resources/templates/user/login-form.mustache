{{> layout/header}}

<div class="container p-5">
    <div class="card">
        <div class="card-header"><b>로그인</b></div>
        <div class="card-body">
<!--  자원요청은 GET요청이 일반적. 하지만 로그인 요청은 예외적으로 사용자의 이름과 비밀번호를 작성해야되기 때문에
 보안상 이유로 반드시 POST 요청. GET을 사용하면 URL에 username , password 전부 드러남. -->
            <form action="/login" method="post">
                <div class="mb-3">
                    <input type="text" class="form-control" placeholder="사용자명" name="username" value="minsu">
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" placeholder="비밀번호" name="password" value="1234">
                </div>
                <button class="btn btn-primary form-control">로그인</button>
            </form>
        </div>
    </div>
</div>

{{> layout/footer}}